{
  "name": "agent-slither",
  "version": "1.0.0",
  "description": "A slither.io-style game arena for AI agents",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc && vite build",
    "start": "node dist/server/index.js",
    "build:client": "vite build",
    "build:reown": "vite build --config vite.reown.config.ts",
    "migrate": "tsx scripts/migrate.ts",
    "backup:db": "tsx scripts/backup-db.ts",
    "normalize-winner-names": "tsx scripts/normalize-winner-names.ts",
    "house-bots": "node scripts/run-house-bots.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.17",
    "@reown/appkit-adapter-ethers": "^1.8.17",
    "cors": "^2.8.5",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "pg": "^8.11.5",
    "skia-canvas": "^3.0.8",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "4.5.0",
    "vitest": "^4.0.18"
  }
}
